# Dits CLI development commands
#
# Run these recipes from `apps/cli` (or pass `--justfile apps/cli/justfile`).
# Install just with: cargo install --locked just

default:
    @just --list

# ============================================================================
# Rust build and verification
# ============================================================================

# Build the current CLI and library targets
build:
    cargo build --locked --all-targets

# Build the current CLI in release mode
build-release:
    cargo build --locked --release -p dits --bin dits

# Run Rust tests, preferring nextest when it is installed
test:
    if command -v cargo-nextest >/dev/null 2>&1; then cargo nextest run --locked; else cargo test --locked; fi

# Run tests for one current workspace package
test-crate crate:
    cargo test --locked -p {{crate}}

# Generate an HTML coverage report (requires cargo-tarpaulin)
coverage:
    cargo tarpaulin --locked --out Html --output-dir target/coverage

# Run all-target, all-feature Clippy checks
lint:
    cargo clippy --locked --all-targets --all-features -- -D warnings

# Format Rust code with the repository's nightly-only formatting options
fmt:
    cargo +nightly fmt --all

# Verify Rust formatting
fmt-check:
    cargo +nightly fmt --all -- --check

# Watch for changes and run locked tests (requires cargo-watch)
watch:
    cargo watch -x 'test --locked'

# Watch for changes and run locked Clippy checks (requires cargo-watch)
watch-lint:
    cargo watch -x 'clippy --locked --all-targets --all-features -- -D warnings'

# ============================================================================
# Shell integration tests
# ============================================================================

# Run the canonical shell integration suite
test-integration:
    cd t && ./run-tests.sh

# Run the shell integration suite with verbose output
test-integration-verbose:
    cd t && ./run-tests.sh --verbose

# Run the shell integration suite in parallel when prove is available
test-integration-parallel:
    cd t && ./run-tests.sh --prove

# Run a top-level integration wrapper selected by filename fragment, e.g. `0100`
test-suite suite:
    cd t && ./run-tests.sh -r "{{suite}}"

# Focused integration shortcuts
test-fastcdc:
    cd t && ./run-tests.sh -r "t0100"

test-video:
    cd t && ./run-tests.sh -r "t0200"

test-filetypes:
    cd t && ./run-tests.sh -r "t0300"

test-edge-cases:
    cd t && ./run-tests.sh -r "t0400"

test-concurrent:
    cd t && ./run-tests.sh -r "t0500"

test-integrity:
    cd t && ./run-tests.sh -r "t0600"

test-stress:
    cd t && ./run-tests.sh -r "t0700"

test-security:
    cd t && ./run-tests.sh -r "t0800"

test-workflows:
    cd t && ./run-tests.sh -r "t0900"

# This suite verifies that the nonfunctional P2P surface fails closed
test-p2p:
    cd t && ./run-tests.sh -r "t1000"

test-lifecycle:
    cd t && ./run-tests.sh -r "t1100"

test-audit:
    cd t && ./run-tests.sh -r "t1200"

test-cross-platform:
    cd t && ./qa/t1300-cross-platform.sh

test-network-failures:
    cd t && ./qa/t1400-network-failures.sh

test-aging:
    cd t && ./qa/t1500-long-term-aging.sh

test-massive-concurrency:
    cd t && ./qa/t1600-massive-concurrency.sh

test-git-recovery:
    cd t && ./qa/t1700-git-recovery-creative-assets.sh

# Validate shell tests with the bundled chainlint implementation
test-chainlint:
    cd t && find . -name "t[0-9][0-9][0-9][0-9]*.sh" -exec perl chainlint.pl {} \;

# ============================================================================
# Documentation and product-truth gates
# ============================================================================

# Build Rust documentation without opening a browser
docs-check:
    cargo doc --locked --no-deps --document-private-items

# Build and open Rust documentation
docs:
    cargo doc --locked --no-deps --open

# Serve previously generated Rust documentation
docs-serve:
    cd target/doc && python3 -m http.server 8080

# Verify CLI documentation against the compiled command surface
cli-docs:
    cd ../.. && bash scripts/check-cli-docs.sh

# Verify public claims against the current alpha boundary
product-truth:
    cd ../.. && bash scripts/check-product-truth.sh

# Verify links in maintained Markdown documentation
markdown-links:
    cd ../.. && node scripts/check-markdown-links.mjs

# ============================================================================
# CLI, web, packaging, and evaluative image
# ============================================================================

# Run a CLI command, e.g. `just cli status`
cli *args:
    cargo run --locked --bin dits -- {{args}}

# Install the current CLI from this workspace
cli-install:
    cargo install --locked --path .

# Run the real engine benchmark used by CI
benchmark:
    cargo test --locked -p dits --release --test benchmarks -- --ignored --nocapture --test-threads=1

# Build the evaluative Linux x64 source image from the repository root
docker-build:
    docker build -t dits:local ../..

# Smoke-test the evaluative image
docker-smoke: docker-build
    docker run --rm dits:local --version

# Validate the web workspace
web-check:
    cd ../.. && npm --workspace apps/web run lint
    cd ../.. && npm --workspace apps/web run test:ci
    cd ../.. && npm --workspace apps/web run build

# Validate the npm launcher and published binary matrix
npm-check:
    cd ../.. && npm test --workspace packages/npm

# Build the binary used by GitHub releases; this does not publish anything
release-build:
    cargo build --locked --release -p dits --bin dits

# ============================================================================
# Aggregate checks and explicit maintenance operations
# ============================================================================

# Fast local correctness gate
check: fmt-check lint test docs-check cli-docs product-truth markdown-links
    @echo "Core checks passed."

# Full local CI-equivalent gate
ci: check test-integration web-check npm-check
    @echo "All local CI-equivalent checks passed."

# Remove Cargo build artifacts
clean:
    cargo clean

# Intentionally refresh locked dependency resolution
update:
    cargo update

# Intentionally regenerate the workspace lockfile
lockfile:
    cargo generate-lockfile

# Audit dependencies represented by Cargo.lock (requires cargo-audit)
audit:
    cargo audit
