{
  "name": "@byronwade/dits",
  "version": "0.1.5",
  "description": "Open-source, local-first version control for large files, media, video, and binary asset pipelines",
  "license": "Apache-2.0 OR MIT",
  "author": "Byron Wade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byronwade/dits.git",
    "directory": "packages/npm"
  },
  "homepage": "https://dits.byronwade.com",
  "bugs": {
    "url": "https://github.com/byronwade/dits/issues"
  },
  "keywords": [
    "version-control",
    "video",
    "binary",
    "large-files",
    "vcs",
    "cli",
    "git",
    "media",
    "deduplication",
    "content-addressed",
    "chunking",
    "blake3",
    "local-first",
    "media-assets",
    "game-development",
    "virtual-production",
    "creative-tools",
    "developer-tools",
    "rust",
    "fastcdc"
  ],
  "bin": {
    "dits": "bin/dits"
  },
  "main": "lib/index.js",
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "echo 'Binaries built via cargo'",
    "clean": "rm -rf bin/darwin-* bin/linux-* bin/win32-*",
