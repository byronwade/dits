{
  "name": "@byronwade/dits",
  "version": "0.1.5",
  "description": "Open, local-first version control for large media and asset pipelines",
  "license": "Apache-2.0 OR MIT",
  "author": "Byron Wade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byronwade/dits.git",
    "directory": "packages/npm"
  },
  "homepage": "https://github.com/byronwade/dits",
  "bugs": {
    "url": "https://github.com/byronwade/dits/issues"
  },
  "keywords": [
    "version-control",
    "video",
    "binary",
    "large-files",
    "vcs",
    "cli",
    "git",
    "media",
    "deduplication",
    "content-addressed",
    "chunking",
    "blake3"
  ],
  "bin": {
