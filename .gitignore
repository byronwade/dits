# Rust specific
# The root workspace ships an application, so its resolved dependency graph is
# committed. Nested historical/research workspaces may keep their own policy.
!/Cargo.lock
*.rlib
*.rmeta
*.so
*.dylib
*.dll

# Debug
debug/
*.pdb
tmp/corpus/

.superpowers/

# Local scratch / manual test repos — never commit
/tmp/
