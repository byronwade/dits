# Keep the Docker build context small and the build reproducible.
# Anything not needed to compile the `dits` CLI is excluded.

# Rust build output (rebuilt inside the image)
target/
**/target/

# Node / web and npm release packages — not part of the CLI build
node_modules/
**/node_modules/
apps/web/
packages/dits-wasm/
packages/npm/
.next/
**/.next/

# Quarantined backend crates (excluded from the workspace anyway)
legacy/

# VCS and local tooling
.git/
.github/
.vscode/
.idea/
.dits/
**/.dits/
.env
.env.*
**/.env
**/.env.*

# Scratch / generated data
tmp/
coverage/
*.log

# The Dockerfile itself doesn't affect the build
Dockerfile
.dockerignore
